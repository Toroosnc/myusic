~/Myusic
Myusic/
.myusic/
*.mp3
*.flac
*.ogg
*.wav
*.m4a

# IDE / editor / OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Packaging/build artifacts
build/
dist/
*.egg-info/
.eggs/
*.whl
*.tar.gz
